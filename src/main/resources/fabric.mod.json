{
	"schemaVersion": 1,
	"id": "rvf",
	"version": "${version}",
	"name": "Record Via Flashback",
	"description": "RVF: adds inventory, perspective, potion effects, spyglass and chat-typing recording to Flashback replays",
	"authors": [
		"VALLENN",
		"JuneFizz"
	],
	"icon": "assets/rvf/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.rvf.RVF"
		]
	},
	"mixins": [
		"rvf.mixins.json",
		{
			"config": "rvf-suggestions.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.10",
		"minecraft": "1.21.10",
		"java": ">=21",
		"fabric-api": "*",
		"flashback": ">=0.39.5 <0.40.0"
	}
}
