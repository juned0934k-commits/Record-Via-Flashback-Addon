{
	"schemaVersion": 1,
	"id": "rvf",
	"version": "${version}",
	"name": "Record Via Flashback",
	"icon": "assets/rvf/icon.png",
	"description": "RVF: adds inventory, perspective, potion effects, spyglass and chat-typing recording to Flashback replays",
	"authors": [
		"VALLENN",
		"JuneFizz"
	],
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.rvf.RVF"
		]
	},
	"mixins": [
		"rvf.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"flashback": ">=0.43.0"
	}
}
